# Environment variables for context-forge
# Copy this to .env and fill in your values

# LLM Provider (any OpenAI-compatible API)
CTXF_LLM_BASE_URL=https://api.openai.com/v1
CTXF_LLM_API_KEY=sk-your-key-here
CTXF_LLM_MODEL=gpt-4o

# Or use local Ollama:
# CTXF_LLM_BASE_URL=http://localhost:11434/v1
# CTXF_LLM_API_KEY=ollama
# CTXF_LLM_MODEL=llama3

# Storage
CTXF_DB_PATH=./playbook.db

# Retrieval
CTXF_RETRIEVAL_TOP_K=10
CTXF_REFINE_THRESHOLD=0.85
CTXF_MAX_BULLETS=500

# API Server
CTXF_HOST=127.0.0.1
CTXF_PORT=8000
